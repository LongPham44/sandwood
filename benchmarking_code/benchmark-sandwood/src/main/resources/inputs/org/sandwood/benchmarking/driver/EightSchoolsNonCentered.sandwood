package org.sandwood.benchmarking.driver;

public model EightSchoolsNonCentered(double[] yObserved, double[] sigma) {
    int J = yObserved.length;

    // parameters
    double[] theta_trans = gaussian(0.0, 1.0).sample(J);
    double mu = gaussian(0.0, 5.0 * 5.0).sample();
    double tau = halfCauchy(0.0, 5.0).sample();

    // transformed parameters: theta = theta_trans * tau + mu
    double[] theta = new double[J];
    for(int j = 0; j < J; j++) {
        theta[j] = theta_trans[j] * tau + mu;
    }

    // y ~ normal(theta, sigma)
    double[] y = new double[J];
    for(int j = 0; j < J; j++) {
        y[j] = gaussian(theta[j], sigma[j] * sigma[j]).sample();
    }

    y.observe(yObserved);
}
