package org.sandwood.benchmarking.driver;

public model Earnings(double[] earnObserved, double[] height, double[] male) {
    int N = earnObserved.length;

    // transformed data: log_earn = log(earn); inter = height .* male
    double[] logEarnObserved = new double[N];
    double[] inter = new double[N];
    for(int n = 0; n < N; n++) {
        logEarnObserved[n] = log(earnObserved[n]);
        inter[n] = height[n] * male[n];
    }

    // parameters
    // Stan leaves these parameters with improper uniform priors. We use broad Gaussian/half-Cauchy priors
    // so the Sandwood model is generative while preserving the regression structure.
    double[] beta = gaussian(0.0, 10.0 * 10.0).sample(4);
    double sigma = halfCauchy(0.0, 10.0).sample();

    // log_earn ~ normal(beta[1] + beta[2] * height + beta[3] * male + beta[4] * inter, sigma)
    double[] logEarn = new double[N];
    for(int n = 0; n < N; n++) {
        double mu = beta[0] + beta[1] * height[n] + beta[2] * male[n] + beta[3] * inter[n];
        logEarn[n] = gaussian(mu, sigma * sigma).sample();
    }
    logEarn.observe(logEarnObserved);
}
